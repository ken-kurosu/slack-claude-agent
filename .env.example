# .env の見本。cp .env.example .env して値を入れる。.env は絶対にコミットしない（.gitignore 済み）
# 値（トークン等）はチャット・Slack・ドキュメントに貼らない。入れるのは管理者だけ

# ── エージェント ──
AGENT_NAME=Agent                 # 表示名（未定なら仮のまま）
AGENT_ID=my-agent                # 英小文字・数字・ハイフン。常駐の登録名・作業フォルダ・ロックに使う（同じ機械の別エージェントと分ける）

# ── Slack（Slack アプリ: Socket Mode） ──
SLACK_BOT_TOKEN=                 # xoxb- で始まる Bot User OAuth Token
SLACK_APP_TOKEN=                 # xapp- で始まる App-Level Token（connections:write）

# ── 権限 ──
ADMIN_USER_IDS=                  # 管理者の Slack ユーザーID（カンマ区切り）。危険な操作の許可・相談先
AGENT_OWNER_SLACK_ID=            # オーナー（砕けた口調で話してよい相手・承認者）。空なら全員に敬語

# ── Claude（Claude Max などのサブスク。docs/CLAUDE_ACCOUNT_SWITCH.md 参照） ──
AI_ENGINE_TYPE=claude_pty        # claude_pty = Claude Code の対話画面を裏で操作（サブスク枠）
CLAUDE_CODE_OAUTH_TOKEN=         # claude setup-token で発行した長期トークン（1年有効）
CLAUDE_BIN=                      # 使う claude CLI のパス（空なら claude-agent-sdk 同梱の CLI）
CLAUDE_CONFIG_DIR=               # Claude の設定フォルダ（空なら ~/.claude）。同じ機械でアカウントを分ける時に指定
# CLAUDE_MODEL=                  # モデルを変える時だけ（既定は config/models.py）
# CLAUDE_MODEL_MEDIUM=
# CLAUDE_MODEL_HEAVY=

# ── 動作 ──
PROACTIVE_CHANNELS=              # 自発的に反応してよいチャンネルID（カンマ区切り）。空ならメンション・DMだけ
# MEMORY_DIR=                    # 記憶の保存先（既定はプロジェクト内 memory_data/）
# WORKSPACE_DIR=                 # 作業ファイルの置き場（既定は /tmp/<AGENT_ID>-workspace）
# AGENT_SDK_CONCURRENCY=1        # 同時に処理する依頼の数（メモリが少ない機械は 1）
